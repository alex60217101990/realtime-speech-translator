//kage:unit pixels

// Audio-reactive entropy sphere.
//
// Five layered effects on a 2D distance field (no separate render
// target needed — composes cleanly with the rest of the Ebiten
// vector layer):
//
//   1. Core gradient    inner blue → outer magenta, modulated by Bass.
//   2. Swirling fBm     a fractal-Brownian-motion field rotated by
//                       Time + Mid; you can see the texture move.
//   3. Star particles   hash-thresholded dots that twinkle on Time,
//                       inside the sphere mask — the "entropy" look.
//   4. Fresnel rim      crisp edge glow, brighter on Treble.
//   5. Halo             soft outer breath, scaled by Rms.
//
// Even at zero audio the sphere visibly drifts because the fBm field
// and the star twinkle ride Time on their own clocks.

package main

var Time float
var Center vec2
var Radius float
var Bass float
var Mid float
var Treble float
var Rms float

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash(i)
	b := hash(i + vec2(1.0, 0.0))
	c := hash(i + vec2(0.0, 1.0))
	d := hash(i + vec2(1.0, 1.0))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func fbm(p vec2) float {
	v := 0.0
	a := 0.5
	for i := 0; i < 5; i++ {
		v += a * noise(p)
		p = p*2.0 + vec2(13.0, 7.0)
		a *= 0.5
	}
	return v
}

// Star field — sparse twinkling dots inside the sphere. Each cell
// of the integer grid hosts a single random "star"; flicker is
// driven by Time so the lattice never feels static.
func stars(uv vec2, t float) float {
	g := uv * 28.0
	cell := floor(g)
	jitter := vec2(hash(cell), hash(cell+vec2(7.3, 1.7)))
	pos := cell + jitter
	d := distance(g, pos)

	// only ~12% of cells host a star
	pick := step(0.88, hash(cell+vec2(3.1, 5.7)))

	twinkle := 0.6 + 0.4*sin(t*4.0+hash(cell)*60.0)
	intensity := smoothstep(0.18, 0.0, d) * twinkle * pick
	return intensity
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Pixel-to-sphere coords; rn=1.0 at the sphere edge.
	p := dstPos.xy - Center
	r := Radius
	rn := length(p) / r

	// Discard far-outside pixels for free — saves fragments on
	// the halo edges of the envelope rect we draw into.
	if rn > 1.45 {
		return vec4(0.0)
	}

	// Rotated UV for the surface texture. Mid spins it faster.
	ang := Time*0.5 + Mid*1.8
	rot := mat2(cos(ang), -sin(ang), sin(ang), cos(ang))
	uv := rot * (p / r)

	// fBm field — drifts on Time on its own clock so the surface
	// always looks alive even at zero audio.
	flow := uv*1.8 + vec2(Time*0.35, -Time*0.20)
	n := fbm(flow)
	// Second fBm with the orthogonal direction → swirl impression.
	n2 := fbm(uv*2.6 + vec2(-Time*0.25, Time*0.45))

	// Crisp core mask.
	displace := 0.02 + 0.05*Bass + 0.03*n
	core := 1.0 - smoothstep(0.985+displace, 1.02+displace, rn)

	// Halo outside the body.
	halo := 1.0 - smoothstep(1.0, 1.4+0.15*Rms, rn)
	halo = halo * halo * 0.55 * (0.6 + 0.4*Rms)

	// Fresnel-style rim — bright thin band just inside the edge.
	rim := pow(clamp(rn, 0.0, 1.0), 18.0)
	rim *= core * (0.7 + 1.8*Treble)

	// Inner colour mix. Use radial position + the rotated noise so
	// the inner glow shifts as the surface texture moves.
	innerCol := vec3(0.22, 0.45, 1.00)
	outerCol := vec3(0.78, 0.30, 1.00)
	rimCol := vec3(0.55, 0.85, 1.00)

	surface := mix(innerCol, outerCol, clamp(rn*0.95+0.20*Bass+0.12*n2, 0.0, 1.0))
	surface += vec3(n2-0.5) * 0.18 // visible swirl modulation

	// Star particles inside the body — the entropy dust.
	starMask := core * (1.0 - smoothstep(0.4, 1.0, rn))
	starPix := stars(uv*1.3, Time) * starMask
	starCol := vec3(0.85, 0.95, 1.00) * starPix * 1.4

	col := surface*core + rimCol*rim + starCol
	// Halo colour borrows from the outer body for a continuous look.
	col += outerCol * halo * 0.6

	alpha := clamp(core+halo+rim, 0.0, 1.0)
	return vec4(col*alpha, alpha)
}

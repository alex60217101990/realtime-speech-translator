//kage:unit pixels

// Audio-reactive particle sphere with energy-field ripples.
//
// Visual reference: a dark sphere body covered with thousands of
// discrete particles (varying brightness, twinkling, drifting),
// with brighter magenta/blue clusters and a translucent rippling
// energy field around the silhouette that pulses on audio.
//
// Layers, in render order:
//
//   1. Dark inner body         deep navy fill, masks particles.
//   2. Cluster nebula          slow fBm of magenta/cyan accents
//                              behind the particles — gives the
//                              "constellation" depth.
//   3. Particles               64x64 cell grid, 60% populated, each
//                              with hash-derived brightness +
//                              independent twinkle phase. Bass
//                              displaces particles along a flow
//                              field so they appear to converge /
//                              disperse on the beat.
//   4. Bright accent stars     a separate sparse layer of brighter
//                              key stars that punctuate the body.
//   5. Fresnel rim             crisp white-blue outline.
//   6. Force-field ripples     concentric rings outside the sphere
//                              that shrink inward, fade with
//                              distance, intensify on Treble.
//   7. Halo                    soft outer breath, scales on Rms.

package main

var Time float
var Center vec2
var Radius float
var Bass float
var Mid float
var Treble float
var Rms float

// --- noise primitives ----------------------------------------------------

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash(i)
	b := hash(i + vec2(1.0, 0.0))
	c := hash(i + vec2(0.0, 1.0))
	d := hash(i + vec2(1.0, 1.0))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func fbm(p vec2) float {
	v := 0.0
	a := 0.5
	for i := 0; i < 4; i++ {
		v += a * noise(p)
		p = p*2.02 + vec2(13.0, 7.0)
		a *= 0.5
	}
	return v
}

// --- particle layers ------------------------------------------------------

// Particles — fish-school swarm via Worley-style 3x3 search.
//
// Behaviour model:
//   schoolDir   slow random global flow vector; every particle pulls
//               toward it (cohesion) so the swarm moves as a body.
//   wiggle      per-particle orbit around its home cell so the body
//               looks alive even at zero audio.
//   scatter     when rms / bass spike, particles burst outward along
//               a per-cell direction; the Go EMA smooths rms over
//               ~80ms so the burst then decays and the school
//               re-forms naturally.
//
// The 3x3 scan keeps the swarm continuous — a particle pushed out
// of its home cell still gets rendered by neighbour cells, so it
// visibly migrates instead of disappearing at the cell boundary.
func particles(uv vec2, t float, bass float, mid float, treble float, rms float) float {
	g := uv * 36.0
	cell := floor(g)
	fp := g - cell

	// Global school direction — slow wander from sum of low-freq sines
	// so the school heading drifts over seconds, not frames.
	schoolDir := vec2(
		sin(t*0.31)+0.5*sin(t*0.71+1.3),
		cos(t*0.27+0.7)+0.5*cos(t*0.59+2.1),
	) * 0.42

	// Periodic school "turn" — every few seconds the school makes a
	// sharp manoeuvre, like a flock dodging. pow(sin, 8) gives long
	// quiet periods then a brief sharp event.
	turnAmp := pow(max(0.0, sin(t*0.45+1.3)), 8.0)
	schoolDir += vec2(cos(t*0.8), sin(t*0.8)) * turnAmp * 0.35

	// Spontaneous burst event — gives a visible scatter even when
	// the audio is silent. Different phase so it doesn't sync with
	// turns.
	burst := pow(max(0.0, sin(t*0.55+2.7)), 12.0)

	minD := 99.0
	minBright := 0.0

	for j := -1; j <= 1; j++ {
		for i := -1; i <= 1; i++ {
			nb := cell + vec2(float(i), float(j))
			h1 := hash(nb)
			h2 := hash(nb + vec2(7.3, 1.7))
			h3 := hash(nb + vec2(3.1, 5.7))
			h4 := hash(nb + vec2(11.1, 13.3))
			h5 := hash(nb + vec2(0.7, 19.3))
			h6 := hash(nb + vec2(23.1, 4.9))

			sens := 0.40 + 0.60*h6

			// Wiggle — fast small orbit around home, amplitude itself
			// breathes so the swarm looks more chaotic than mechanical.
			wigPhase := t*(1.1+h1*1.8) + h2*40.0
			wigAmp := 0.20 + 0.10*sin(t*0.4+h1*5.0)
			wiggle := vec2(cos(wigPhase), sin(wigPhase)) * wigAmp

			// Cohesion — pulls particle toward the global flow heading.
			cohesion := schoolDir * (0.50 + 0.25*h5)

			// Mid rotates the cohesion slightly per-particle so the
			// school isn't a single rigid block.
			rotA := mid*1.2 + h1*0.6
			c := cos(rotA)
			s := sin(rotA)
			cohesion = mat2(c, -s, s, c) * cohesion

			// Scatter — radial burst along per-cell direction. Driven
			// by audio AND the spontaneous burst event so the school
			// scatters periodically even in silence.
			scatAng := h5 * 6.2832
			scatDir := vec2(cos(scatAng), sin(scatAng))
			scatter := scatDir * (rms*3.4*sens + bass*1.8*sens + burst*0.55*sens) * 0.95

			home := vec2(h1, h2)
			off := home + wiggle + cohesion + scatter

			diff := vec2(float(i), float(j)) + off - fp
			d := length(diff)

			if d < minD {
				minD = d
				pick := step(0.30, h3)
				bright := 0.30 + 0.70*h4
				tw := 0.60 + 0.40*sin(t*(2.0+h1*4.0)+h1*60.0)
				minBright = pick * bright * tw
			}
		}
	}

	r := 0.17 + 0.05*rms + 0.025*treble
	return smoothstep(r, 0.0, minD) * minBright
}

// Accent stars — sparser, brighter layer on top of the particles
// so the eye locks onto a few key bright points.
func accentStars(uv vec2, t float) float {
	g := uv * 18.0
	cell := floor(g)
	jitter := vec2(hash(cell+vec2(0.1, 0.2)), hash(cell+vec2(0.3, 0.4)))
	pos := cell + jitter
	d := distance(g, pos)
	pick := step(0.93, hash(cell+vec2(7.7, 3.3)))
	tw := 0.6 + 0.4*sin(t*4.0+hash(cell)*100.0)
	return smoothstep(0.12, 0.0, d) * pick * tw
}

// --- waveform field outside ----------------------------------------------

// --- waveform field outside ----------------------------------------------

// waveform draws a smooth sinusoidal closed loop around the sphere.
// The loop's radius at each angle is the sum of three harmonics —
// low (bass), mid (mid), high (treble) — so loud voice produces
// taller peaks and silence flattens it back to a still ring.
//
// Smooth (not EKG-style) so the trace reads as flowing energy.
func waveform(rn float, ang float, t float, bass float, mid float, treble float, rms float) float {
	if rn < 1.0 {
		return 0.0
	}
	// Three angular harmonics at different frequencies. Each scrolls
	// at its own rate so the trace never settles into a static shape.
	w1 := sin(ang*3.0+t*0.55) * (0.04 + 0.70*bass)
	w2 := sin(ang*7.0-t*0.85) * (0.03 + 0.48*mid)
	w3 := sin(ang*15.0+t*1.30) * (0.02 + 0.38*treble)

	// Soft floor so the ring is always visible.
	base := 0.02 + 0.02*sin(ang*5.0+t*0.7)

	peak := w1 + w2 + w3 + base
	wavR := 1.16 + peak

	line := smoothstep(0.045, 0.0, abs(rn-wavR))
	fade := smoothstep(1.55, 1.05, rn)
	return line * fade
}

// ghostWave is a second, fainter inner trace closer to the body.
// Two smooth traces give the "energy halo" feel.
func ghostWave(rn float, ang float, t float, bass float, mid float) float {
	if rn < 1.0 {
		return 0.0
	}
	w := sin(ang*5.0-t*0.9) * (0.025 + 0.18*bass)
	w += sin(ang*11.0+t*1.5) * (0.015 + 0.12*mid)
	wavR := 1.08 + w
	line := smoothstep(0.035, 0.0, abs(rn-wavR))
	fade := smoothstep(1.35, 1.02, rn)
	return line * fade
}

// --- main fragment -------------------------------------------------------

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	p := dstPos.xy - Center
	r := Radius
	rn := length(p) / r

	if rn > 1.55 {
		return vec4(0.0)
	}

	uv := p / r

	// Body masks — sphere outline plus the soft halo behind it.
	displace := 0.08 * Bass
	core := 1.0 - smoothstep(0.985+displace, 1.02+displace, rn)
	halo := 1.0 - smoothstep(1.0, 1.4+0.55*Rms, rn)
	halo = halo * halo * 0.55

	// Dark body fill — deep navy with a slight magenta tint near
	// the rim so the silhouette never looks dead-flat.
	bodyDark := vec3(0.04, 0.05, 0.12)
	bodyEdge := vec3(0.12, 0.06, 0.20)
	body := mix(bodyDark, bodyEdge, rn*rn)

	// Cluster nebula behind the particles — large blobs of warm /
	// cool tint that drift slowly. This is the visible "depth"
	// behind the dust.
	ang := atan2(uv.y, uv.x)
	suv := uv*1.3 + vec2(cos(ang)*0.3, sin(ang)*0.3)
	cluster := fbm(suv*1.6 + vec2(Time*0.10, -Time*0.07))
	cluster = pow(cluster, 1.4)

	// Drifting palette so the cluster colour shifts every few
	// seconds without becoming metronomic.
	t1 := 0.5 + 0.5*sin(Time*0.09)
	t2 := 0.5 + 0.5*sin(Time*0.13+1.7)
	colA := mix(vec3(0.18, 0.10, 0.55), vec3(0.60, 0.15, 0.85), t1)
	colB := mix(vec3(0.10, 0.30, 0.85), vec3(0.20, 0.70, 1.00), t2)
	clusterCol := mix(colB, colA, cluster) * cluster * 0.45

	// Particle dust — masked to the inside, brighter near the
	// equator (1 - rn drop-off keeps the silhouette dark so we
	// can see the rim). Reactive layer: bass/mid/treble/rms all
	// feed in so the swarm scatters on loud frames.
	innerFalloff := smoothstep(1.0, 0.5, rn)
	dust := particles(uv, Time, Bass, Mid, Treble, Rms) * innerFalloff
	dustCol := mix(vec3(0.55, 0.70, 1.00), vec3(0.90, 0.50, 1.00), cluster)
	dust *= 1.4 + 1.8*Bass + 1.6*Rms

	// Accent stars — a few bright key points.
	acc := accentStars(uv, Time) * innerFalloff
	accCol := vec3(1.00, 0.95, 0.85) * 1.6

	// Fresnel rim — crisp outline.
	rim := pow(clamp(rn, 0.0, 1.0), 24.0) * core
	rimCol := vec3(0.65, 0.85, 1.00) * (0.9 + 1.6*Treble)

	// Smooth waveform halo outside the body — two flowing sinusoidal
	// traces that pulse with the audio. Outer is full-spectrum, inner
	// (ghost) is the calmer companion line.
	wave := waveform(rn, ang, Time, Bass, Mid, Treble, Rms)
	ghost := ghostWave(rn, ang, Time, Bass, Mid) * 0.7
	waveCol := vec3(0.45, 0.80, 1.00) * (0.7 + 1.4*Treble + 0.6*Rms)

	// Compose.
	col := vec3(0.0)
	col += (body + clusterCol) * core
	col += dustCol * dust * core
	col += accCol * acc * core
	col += rimCol * rim
	col += waveCol * (wave + ghost)
	col += mix(colA, colB, 0.5) * halo * 0.30 * (0.5 + 0.5*Rms)

	alpha := clamp(core+halo*0.5+rim+(wave+ghost)*0.85, 0.0, 1.0)
	return vec4(col*alpha, alpha)
}

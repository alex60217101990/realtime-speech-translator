//kage:unit pixels

// Audio-reactive particle sphere with energy-field ripples.
//
// Visual reference: a dark sphere body covered with thousands of
// discrete particles (varying brightness, twinkling, drifting),
// with brighter magenta/blue clusters and a translucent rippling
// energy field around the silhouette that pulses on audio.
//
// Layers, in render order:
//
//   1. Dark inner body         deep navy fill, masks particles.
//   2. Cluster nebula          slow fBm of magenta/cyan accents
//                              behind the particles — gives the
//                              "constellation" depth.
//   3. Particles               64x64 cell grid, 60% populated, each
//                              with hash-derived brightness +
//                              independent twinkle phase. Bass
//                              displaces particles along a flow
//                              field so they appear to converge /
//                              disperse on the beat.
//   4. Bright accent stars     a separate sparse layer of brighter
//                              key stars that punctuate the body.
//   5. Fresnel rim             crisp white-blue outline.
//   6. Force-field ripples     concentric rings outside the sphere
//                              that shrink inward, fade with
//                              distance, intensify on Treble.
//   7. Halo                    soft outer breath, scales on Rms.

package main

var Time float
var Center vec2
var Radius float
var Bass float
var Mid float
var Treble float
var Rms float

// --- noise primitives ----------------------------------------------------

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3.0 - 2.0*f)
	a := hash(i)
	b := hash(i + vec2(1.0, 0.0))
	c := hash(i + vec2(0.0, 1.0))
	d := hash(i + vec2(1.0, 1.0))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func fbm(p vec2) float {
	v := 0.0
	a := 0.5
	for i := 0; i < 4; i++ {
		v += a * noise(p)
		p = p*2.02 + vec2(13.0, 7.0)
		a *= 0.5
	}
	return v
}

// --- particle layers ------------------------------------------------------

// Particles — dense grid of small dots. Bass + audio modulate a
// flow-field displacement so the swarm visibly contracts toward
// hot spots and re-disperses when the beat decays.
//
// density   cells per radius (sets grain size; 64 = thousands of
//           particles across the body).
// pick      hash threshold; 0.4 → ~60% of cells host a particle.
// twinkle   per-particle phase from hash, so the swarm never feels
//           synchronized.
func particles(uv vec2, t float, bass float, mid float) float {
	// Slow flow field for converge / disperse.
	flow := vec2(
		fbm(uv*0.7+vec2(t*0.10, 0.0)),
		fbm(uv*0.7+vec2(0.0, t*0.10)),
	) - 0.5

	// Bass collapses particles inward toward field nodes; mid
	// rotates the displacement slightly so the contraction is
	// not radial.
	displace := flow * (0.02 + 0.10*bass)
	rot := mat2(cos(mid), -sin(mid), sin(mid), cos(mid))
	uv = uv - rot*displace

	g := uv * 64.0
	cell := floor(g)
	jitter := vec2(hash(cell), hash(cell+vec2(7.3, 1.7)))
	pos := cell + jitter
	d := distance(g, pos)

	pick := step(0.40, hash(cell+vec2(3.1, 5.7)))
	bright := 0.25 + 0.75*hash(cell+vec2(11.1, 13.3))
	tw := 0.55 + 0.45*sin(t*(2.0+hash(cell)*4.0)+hash(cell)*60.0)

	return smoothstep(0.18, 0.0, d) * pick * bright * tw
}

// Accent stars — sparser, brighter layer on top of the particles
// so the eye locks onto a few key bright points.
func accentStars(uv vec2, t float) float {
	g := uv * 18.0
	cell := floor(g)
	jitter := vec2(hash(cell+vec2(0.1, 0.2)), hash(cell+vec2(0.3, 0.4)))
	pos := cell + jitter
	d := distance(g, pos)
	pick := step(0.93, hash(cell+vec2(7.7, 3.3)))
	tw := 0.6 + 0.4*sin(t*4.0+hash(cell)*100.0)
	return smoothstep(0.12, 0.0, d) * pick * tw
}

// --- energy field outside ------------------------------------------------

// Concentric ripple rings + angular streaks, faded with distance.
// Visible only outside the sphere (rn > 1).
func forceField(rn float, ang float, t float, audio float) float {
	if rn < 1.0 {
		return 0.0
	}
	// 5 ring set inside the halo band [1.0, 1.4]; they shrink
	// inward over time (negative phase) so the "shield" looks
	// like it's being struck and ripples toward the body.
	band := smoothstep(1.45, 1.02, rn)
	rings := sin((rn-1.0)*38.0-t*3.5) * 0.5 + 0.5
	rings = pow(rings, 2.0)

	// Angular streaks running around the surface — modest count
	// so they read as direction lines, not stripes.
	streaks := pow(sin(ang*7.0+t*1.2)*0.5+0.5, 4.0)

	return band * rings * (0.45 + 0.55*audio + 0.30*streaks)
}

// --- main fragment -------------------------------------------------------

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	p := dstPos.xy - Center
	r := Radius
	rn := length(p) / r

	if rn > 1.55 {
		return vec4(0.0)
	}

	uv := p / r

	// Body masks — sphere outline plus the soft halo behind it.
	displace := 0.03 * Bass
	core := 1.0 - smoothstep(0.985+displace, 1.02+displace, rn)
	halo := 1.0 - smoothstep(1.0, 1.4+0.18*Rms, rn)
	halo = halo * halo * 0.55

	// Dark body fill — deep navy with a slight magenta tint near
	// the rim so the silhouette never looks dead-flat.
	bodyDark := vec3(0.04, 0.05, 0.12)
	bodyEdge := vec3(0.12, 0.06, 0.20)
	body := mix(bodyDark, bodyEdge, rn*rn)

	// Cluster nebula behind the particles — large blobs of warm /
	// cool tint that drift slowly. This is the visible "depth"
	// behind the dust.
	ang := atan2(uv.y, uv.x)
	suv := uv*1.3 + vec2(cos(ang)*0.3, sin(ang)*0.3)
	cluster := fbm(suv*1.6 + vec2(Time*0.10, -Time*0.07))
	cluster = pow(cluster, 1.4)

	// Drifting palette so the cluster colour shifts every few
	// seconds without becoming metronomic.
	t1 := 0.5 + 0.5*sin(Time*0.09)
	t2 := 0.5 + 0.5*sin(Time*0.13+1.7)
	colA := mix(vec3(0.18, 0.10, 0.55), vec3(0.60, 0.15, 0.85), t1)
	colB := mix(vec3(0.10, 0.30, 0.85), vec3(0.20, 0.70, 1.00), t2)
	clusterCol := mix(colB, colA, cluster) * cluster * 0.45

	// Particle dust — masked to the inside, brighter near the
	// equator (1 - rn drop-off keeps the silhouette dark so we
	// can see the rim).
	innerFalloff := smoothstep(1.0, 0.5, rn)
	dust := particles(uv, Time, Bass, Mid) * innerFalloff
	dustCol := mix(vec3(0.55, 0.70, 1.00), vec3(0.90, 0.50, 1.00), cluster)
	dust *= 1.4 + 0.6*Bass

	// Accent stars — a few bright key points.
	acc := accentStars(uv, Time) * innerFalloff
	accCol := vec3(1.00, 0.95, 0.85) * 1.6

	// Fresnel rim — crisp outline.
	rim := pow(clamp(rn, 0.0, 1.0), 24.0) * core
	rimCol := vec3(0.65, 0.85, 1.00) * (0.9 + 1.6*Treble)

	// Force-field ripples outside the body.
	field := forceField(rn, ang, Time, 0.30+0.7*Rms)
	fieldCol := vec3(0.40, 0.75, 1.00) * (0.4 + 1.2*Treble)

	// Compose.
	col := vec3(0.0)
	col += (body + clusterCol) * core
	col += dustCol * dust * core
	col += accCol * acc * core
	col += rimCol * rim
	col += fieldCol * field
	col += mix(colA, colB, 0.5) * halo * 0.30 * (0.5 + 0.5*Rms)

	alpha := clamp(core+halo*0.5+rim+field*0.6, 0.0, 1.0)
	return vec4(col*alpha, alpha)
}
